
protocol LL25_[[17,1,5]]_[2,2,2,1,1]^T:

    code:
        [[17,1,5]]

        [[Z1, Z2, Z3, Z4],
         [Z1, Z3, Z5, Z6],
         [Z5, Z6, Z9, Z10],
         [Z7, Z8, Z11, Z12],
         [Z9, Z10, Z13, Z14],
         [Z11, Z12, Z15, Z16],
         [Z8, Z12, Z16, Z17],
         [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
         [X1, X2, X3, X4],
         [X1, X3, X5, X6],
         [X5, X6, X9, X10],
         [X7, X8, X11, X12],
         [X9, X10, X13, X14],
         [X11, X12, X15, X16],
         [X8, X12, X16, X17],
         [X3, X4, X6, X7, X10, X11, X14, X15]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qd: data
            qm: syn
            g: [[Z1, Z2, Z3, Z4],
             [Z1, Z3, Z5, Z6],
             [Z5, Z6, Z9, Z10],
             [Z7, Z8, Z11, Z12],
             [Z9, Z10, Z13, Z14],
             [Z11, Z12, Z15, Z16],
             [Z8, Z12, Z16, Z17],
             [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
             [X1, X2, X3, X4],
             [X1, X3, X5, X6],
             [X5, X6, X9, X10],
             [X7, X8, X11, X12],
             [X9, X10, X13, X14],
             [X11, X12, X15, X16],
             [X8, X12, X16, X17],
             [X3, X4, X6, X7, X10, X11, X14, X15]]
        }

        FSE_f {
            file: "./FSE_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1, Z2, Z3, Z4],
             [Z1, Z3, Z5, Z6],
             [Z5, Z6, Z9, Z10],
             [Z7, Z8, Z11, Z12],
             [Z9, Z10, Z13, Z14],
             [Z11, Z12, Z15, Z16],
             [Z8, Z12, Z16, Z17],
             [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
             [X1, X2, X3, X4],
             [X1, X3, X5, X6],
             [X5, X6, X9, X10],
             [X7, X8, X11, X12],
             [X9, X10, X13, X14],
             [X11, X12, X15, X16],
             [X8, X12, X16, X17],
             [X3, X4, X6, X7, X10, X11, X14, X15]]
            #-flag: 2
        }

    gvar:
        bit[16] m1 = ⊥;
        bit[16] m2 = ⊥;
        bit[16] m3 = ⊥;
        bit[14] f1 = ⊥;
        bit[14] f2 = ⊥;
        bit[14] f3 = ⊥;

    tc:
        1: (m1 == 0) and (f1 == 0)
        2: (f2 != ⊥) and (f2 != 0)
        3: (f3 != ⊥)

    af:
        while (!tc) {
            if (m1 == ⊥) { (m1, f1) = FSE_f(); }
            else if (f2 == ⊥) { (m2, f2) = FSE_f(); }
            else { (m3, f3) = FSE_f(); }
        }

    tp:
        1: {
            end();
        }

        2: {
            (m3,) = FSE_b();
            decode(mr[m1, f1, m2, f2, m3]);
        }

        3: {
            if ((m2 == 0) and (m3 == 0) and (f3 == 0)) {
                decode(mr[m1, f1, m2, f2, m3, f3]);
            }
            else {
                bit[16] m4 = ⊥;
                (m4,) = FSE_b();
                decode(mr[m1, f1, m2, f2, m3, f3, m4]);
            }
        }
