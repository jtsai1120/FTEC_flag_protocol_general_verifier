
protocol CB18_[[17,1,5]]_plain:

    code:
        [[17,1,5]]

        [[Z1, Z2, Z3, Z4],
         [X1, X2, X3, X4],
         [Z1, Z3, Z5, Z6],
         [X1, X3, X5, X6],
         [Z5, Z6, Z9, Z10],
         [X5, X6, X9, X10],
         [Z7, Z8, Z11, Z12],
         [X7, X8, X11, X12],
         [Z9, Z10, Z13, Z14],
         [X9, X10, X13, X14],
         [Z11, Z12, Z15, Z16],
         [X11, X12, X15, X16],
         [Z8, Z12, Z16, Z17],
         [X8, X12, X16, X17],
         [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
         [X3, X4, X6, X7, X10, X11, X14, X15]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qd: data
            qm: syn
            g: [[Z1, Z2, Z3, Z4],
             [X1, X2, X3, X4],
             [Z1, Z3, Z5, Z6],
             [X1, X3, X5, X6],
             [Z5, Z6, Z9, Z10],
             [X5, X6, X9, X10],
             [Z7, Z8, Z11, Z12],
             [X7, X8, X11, X12],
             [Z9, Z10, Z13, Z14],
             [X9, X10, X13, X14],
             [Z11, Z12, Z15, Z16],
             [X11, X12, X15, X16],
             [Z8, Z12, Z16, Z17],
             [X8, X12, X16, X17],
             [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
             [X3, X4, X6, X7, X10, X11, X14, X15]]
        }

        FSE_f {
            file: "./FSE_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1, Z2, Z3, Z4],
             [X1, X2, X3, X4],
             [Z1, Z3, Z5, Z6],
             [X1, X3, X5, X6],
             [Z5, Z6, Z9, Z10],
             [X5, X6, X9, X10],
             [Z7, Z8, Z11, Z12],
             [X7, X8, X11, X12],
             [Z9, Z10, Z13, Z14],
             [X9, X10, X13, X14],
             [Z11, Z12, Z15, Z16],
             [X11, X12, X15, X16],
             [Z8, Z12, Z16, Z17],
             [X8, X12, X16, X17],
             [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
             [X3, X4, X6, X7, X10, X11, X14, X15]]
            #-flag: 2
        }

    gvar:
        cnt n_c_same  = 0;
        cnt n_same    = 0;
        cnt n_diff    = 0;
        cnt n_flag    = 0;

        bit[16] s_prev     = ⊥;
        bit     diff_prev  = 0;
        mr      m          = mr[];

    tc:
        1: ((n_c_same == 3 - n_diff - 1 and n_c_same != 0) and n_flag == 0)
        2: (n_diff == 2 and n_flag == 0)
        3: (n_flag == 2)
        4: (n_diff == 1 and n_flag == 1)
        5: (n_same == 1 and n_diff == 0 and n_flag == 1)

    af:
        while(!tc) {
            bit[16]  s  = ⊥;
            bit[20]  f  = ⊥;

            (s, f) = FSE_f();

            if (f != 0) { 
                n_c_same  = 0;
                n_same    = 0;
                n_flag   += 1;
                s_prev    = ⊥;
                diff_prev = 0;
                m.push(f);
                continue;   
            }

            if (s_prev != ⊥) {
                if (diff_prev == 1) { 
                    diff_prev = 0; 
                }
                else if (s == s_prev) { 
                    n_c_same += 1;
                    n_same   += 1;
                }
                else {
                    n_c_same  = 0;
                    n_diff   += 1;
                    diff_prev = 1;
                }
            }

            s_prev = s;
        }

    tp:
        1: { 
            decode(mr[s_prev]);
        }
        2: { 
            bit[16] s = ⊥;
            (s,) = FSE_b();
            decode(mr[s]);
        }
        3: { 
            bit[16] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m); 
        }
        4: {
            bit[16] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m); 
        }
        5: {
            m.push(s_prev);
            decode(m); 
        }
