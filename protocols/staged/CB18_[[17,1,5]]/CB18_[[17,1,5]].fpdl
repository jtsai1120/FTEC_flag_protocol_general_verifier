
protocol CB_18_[[17,1,5]]:

    code:
        [[17,1,5]]

        [[Z1, Z2, Z3, Z4],
         [X1, X2, X3, X4],
         [Z1, Z3, Z5, Z6],
         [X1, X3, X5, X6],
         [Z5, Z6, Z9, Z10],
         [X5, X6, X9, X10],
         [Z7, Z8, Z11, Z12],
         [X7, X8, X11, X12],
         [Z9, Z10, Z13, Z14],
         [X9, X10, X13, X14],
         [Z11, Z12, Z15, Z16],
         [X11, X12, X15, X16],
         [Z8, Z12, Z16, Z17],
         [X8, X12, X16, X17],
         [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
         [X3, X4, X6, X7, X10, X11, X14, X15]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qd: data
            qm: syn
            g: [[Z1, Z2, Z3, Z4],
             [X1, X2, X3, X4],
             [Z1, Z3, Z5, Z6],
             [X1, X3, X5, X6],
             [Z5, Z6, Z9, Z10],
             [X5, X6, X9, X10],
             [Z7, Z8, Z11, Z12],
             [X7, X8, X11, X12],
             [Z9, Z10, Z13, Z14],
             [X9, X10, X13, X14],
             [Z11, Z12, Z15, Z16],
             [X11, X12, X15, X16],
             [Z8, Z12, Z16, Z17],
             [X8, X12, X16, X17],
             [Z3, Z4, Z6, Z7, Z10, Z11, Z14, Z15],
             [X3, X4, X6, X7, X10, X11, X14, X15]]
        }

        g1f {
            file: "./Z1Z2Z3Z4_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1,Z2,Z3,Z4]]
            #-flag: 2
        }

        g2f {
            file: "./X1X2X3X4_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X1,X2,X3,X4]]
            #-flag: 2
        }

        g3f {
            file: "./Z1Z3Z5Z6_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1,Z3,Z5,Z6]]
            #-flag: 2
        }

        g4f {
            file: "./X1X3X5X6_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X1,X3,X5,X6]]
            #-flag: 2
        }

        g5f {
            file: "./Z5Z6Z9Z10_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z5,Z6,Z9,Z10]]
            #-flag: 2
        }

        g6f {
            file: "./X5X6X9X10_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X5,X6,X9,X10]]
            #-flag: 2
        }

        g7f {
            file: "./Z7Z8Z11Z12_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z7,Z8,Z11,Z12]]
            #-flag: 2
        }

        g8f {
            file: "./X7X8X11X12_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X7,X8,X11,X12]]
            #-flag: 2
        }

        g9f {
            file: "./Z9Z10Z13Z14_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z9,Z10,Z13,Z14]]
            #-flag: 2
        }

        g10f {
            file: "./X9X10X13X14_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X9,X10,X13,X14]]
            #-flag: 2
        }

        g11f {
            file: "./Z11Z12Z15Z16_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z11,Z12,Z15,Z16]]
            #-flag: 2
        }

        g12f {
            file: "./X11X12X15X16_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X11,X12,X15,X16]]
            #-flag: 2
        }

        g13f {
            file: "./Z8Z12Z16Z17_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z8,Z12,Z16,Z17]]
            #-flag: 2
        }

        g14f {
            file: "./X8X12X16X17_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X8,X12,X16,X17]]
            #-flag: 2
        }

        g15f {
            file: "./Z3Z4Z6Z7Z10Z11Z14Z15_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z3,Z4,Z6,Z7,Z10,Z11,Z14,Z15]]
            #-flag: 2
        }

        g16f {
            file: "./X3X4X6X7X10X11X14X15_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[X3,X4,X6,X7,X10,X11,X14,X15]]
            #-flag: 2
        }

    gvar:
        cnt n_c_same  = 0;
        cnt n_same    = 0;
        cnt n_diff    = 0;
        cnt n_flag    = 0;

        bit[]   s_prev     = ⊥;
        bit     diff_prev  = 0;
        mr      m          = mr[];

    tc:
        1: ((n_c_same == 3 - n_diff - 1 and n_c_same != 0) and n_flag == 0)
        2: (n_diff == 2 and n_flag == 0)
        3: (n_flag == 2)
        4: (n_diff == 1 and n_flag == 1)
        5: (n_same == 1 and n_diff == 0 and n_flag == 1)

    af:
        while(!tc) {
            se<(bit, bit[])>[16] gf = [g1f, g2f, g3f, g4f, g5f, g6f, g7f, g8f, g9f, g10f, g11f, g12f, g13f, g14f, g15f, g16f];
            bit[]   s  = [];
            bit     si = ⊥;
            bit[]   fi = ⊥;  
            cnt      i = 0;
            bit     flagged = 0;

            while (i < 16) {
                (si, fi) = gf[i]();
                s.push(si);
                if (fi != 0) {
                    n_c_same  = 0;
                    n_same    = 0;
                    n_flag   += 1;
                    s_prev    = ⊥;
                    diff_prev = 0;
                    m.push(i+1);
                    flagged   = 1;
                    break;
                }
                i++;
            }

            if (flagged == 1) { continue; }

            if (s_prev != ⊥) {
                if (diff_prev == 1) { 
                    diff_prev = 0; 
                }
                else if (s == s_prev) { 
                    n_c_same += 1;
                    n_same   += 1;
                }
                else {
                    n_c_same  = 0;
                    n_diff   += 1;
                    diff_prev = 1;
                }
            }

            s_prev = s;
        }

    tp:
        1: { 
            decode(mr[s_prev]);
        }
        2: { 
            bit[16] s = ⊥;
            (s,) = FSE_b();
            decode(mr[s]);
        }
        3: { 
            bit[16] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m); 
        }
        4: {
            bit[16] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m); 
        }
        5: {
            m.push(s_prev);
            decode(m); 
        }
