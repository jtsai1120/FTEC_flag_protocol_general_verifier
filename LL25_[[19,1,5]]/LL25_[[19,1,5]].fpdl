
protocol LL25_[[19,1,5]]:

    code:
        [[19,1,5]]

        [[Z1, Z2, Z3, Z4],
         [Z1, Z3, Z5, Z7],
         [Z12, Z13, Z14, Z15],
         [Z1, Z2, Z5, Z6, Z8, Z9],
         [Z6, Z9, Z16, Z19],
         [Z16, Z17, Z18, Z19],
         [Z10, Z11, Z12, Z15],
         [Z8, Z9, Z10, Z11, Z16, Z17],
         [Z5, Z7, Z8, Z11, Z12, Z13],
         [X1, X2, X3, X4],
         [X1, X3, X5, X7],
         [X12, X13, X14, X15],
         [X1, X2, X5, X6, X8, X9],
         [X6, X9, X16, X19],
         [X16, X17, X18, X19],
         [X10, X11, X12, X15],
         [X8, X9, X10, X11, X16, X17],
         [X5, X7, X8, X11, X16, X17]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qp: data
            qm: syn
            cm: m
            g: [[Z1, Z2, Z3, Z4],
             [Z1, Z3, Z5, Z7],
             [Z12, Z13, Z14, Z15],
             [Z1, Z2, Z5, Z6, Z8, Z9],
             [Z6, Z9, Z16, Z19],
             [Z16, Z17, Z18, Z19],
             [Z10, Z11, Z12, Z15],
             [Z8, Z9, Z10, Z11, Z16, Z17],
             [Z5, Z7, Z8, Z11, Z12, Z13],
             [X1, X2, X3, X4],
             [X1, X3, X5, X7],
             [X12, X13, X14, X15],
             [X1, X2, X5, X6, X8, X9],
             [X6, X9, X16, X19],
             [X16, X17, X18, X19],
             [X10, X11, X12, X15],
             [X8, X9, X10, X11, X16, X17],
             [X5, X7, X8, X11, X16, X17]]
        }

        FSE_f {
            file: "./FSE_f.qasm"
            qp: data
            qm: syn
            cm: m
            qf: flag
            cf: f
            g: [[Z1, Z2, Z3, Z4],
             [Z1, Z3, Z5, Z7],
             [Z12, Z13, Z14, Z15],
             [Z1, Z2, Z5, Z6, Z8, Z9],
             [Z6, Z9, Z16, Z19],
             [Z16, Z17, Z18, Z19],
             [Z10, Z11, Z12, Z15],
             [Z8, Z9, Z10, Z11, Z16, Z17],
             [Z5, Z7, Z8, Z11, Z12, Z13],
             [X1, X2, X3, X4],
             [X1, X3, X5, X7],
             [X12, X13, X14, X15],
             [X1, X2, X5, X6, X8, X9],
             [X6, X9, X16, X19],
             [X16, X17, X18, X19],
             [X10, X11, X12, X15],
             [X8, X9, X10, X11, X16, X17],
             [X5, X7, X8, X11, X16, X17]]
            #-flag: 2
        }

    gvar:
        bit[18] m1 = ⊥;
        bit[18] m2 = ⊥;
        bit[18] m3 = ⊥;
        bit[24] f1 = ⊥;
        bit[24] f2 = ⊥;
        bit[24] f3 = ⊥;
    
    tc:
        1: (m1 == 0) and (f1 == 0)
        2: (f2 != ⊥) and (f2 != 0)
        3: (f3 != ⊥)

    af:
        while (!tc) {
            if (m1 == ⊥) { (m1, f1) = FSE_f(); }
            else if (f2 == ⊥) { (m2, f2) = FSE_f(); }
            else { (m3, f3) = FSE_f(); }
        }

    tp:
        1: {}

        2: {
            (m3,) = FSE_b();
            decode(mr[m1, f1, m2, f2, m3]);
        }

        3: {
            if ((m2 == 0) and (m3 == 0) and (f3 == 0)) {
                decode(mr[m1, f1, m2, f2, m3, f3]);
            } 
            else {
                bit[18] m4 = ⊥;
                (m4,) = FSE_b();
                decode(mr[m1, f1, m2, f2, m3, f3, m4]);
            }
        }
